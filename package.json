{
  "name": "ms-nrbf-js",
  "version": "0.1.0",
  "description": "Read and write MS-NRBF (.NET Remoting Binary Format) encoded binary files",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "keywords": [
    "nrbf",
    "ms-nrbf",
    "dotnet",
    "binary",
    "serialization",
    "remoting",
    "binaryformatter"
  ],
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fushi/ms-nrbf-js.git"
  },
  "bugs": {
    "url": "https://github.com/fushi/ms-nrbf-js/issues"
  },
  "homepage": "https://github.com/fushi/ms-nrbf-js#readme",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
